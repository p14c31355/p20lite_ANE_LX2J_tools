# The firmware archives are ~13 GB - far past any git remote's limits.
# They live on archive.org instead; see README.md ("Firmware").
firmware/azrom/*.zip
firmware/azrom/*.rar

# Boot images are large binaries and reproducible from source with
# tools/builders/mkane_stock_embed.py; keep them local (they live in
# the p20-root working tree). One exception: the current screen-reader
# probe is what users need first, so it is allowed through.
artifacts/*.img
artifacts/*.bin
!artifacts/fullerene-ane-log-probe-stock.img

# Screen captures are evidence, not source.
logs/screens/*.jpg

# The bootloader-unlock archive keeps the *small* irreplaceable files
# (nvme images, oeminfo gamma, frp, the exploit binary, the CVE source) but
# the multi-megabyte derived dumps stay local - recover them from the device
# or from the original backups directory.
unlock/device-dumps/oeminfo.bin
unlock/device-dumps/dts_stock.bin
unlock/lk/lk.asm

# The consolidated lk disassembly from p20-root (12 MB, derived from
# fastboot_LK.bin which is tracked).
unlock/lk_asm/

# False-positive: the stock kernel ELF contains random bytes that GitHub's
# secret scanner flags as a Figma token. Keep it local (it is a derived
# artifact, reconstructible with vmlinux-to-elf from firmware/).
unlock/backup/kernel_8.0.0.110.elf
unlock/backup/oeminfo.bin
# Internet Archive upload logs (transient)
internetarchive.log
